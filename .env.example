# Developer Interface settings. ./install.sh writes .env from this with fresh secrets; edit .env, then: docker compose up -d
DI_IMAGE=ghcr.io/lotfy2125/developerinterface
DI_VERSION=2.0.5

# The address people open. It's part of this install's Activation ID: keep it fixed (a DNS name, or a fixed IP address).
APP_URL=http://192.168.1.10:8080
APP_PORT=8080

# HTTPS at a DNS name (set by ./install.sh --domain): COMPOSE_PROFILES=https, DOMAIN and ACME_EMAIL.
COMPOSE_PROFILES=
DOMAIN=
ACME_EMAIL=

# Secrets: made by install.sh. Never share this file.
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=

# Email for password reset links (optional). Without it, admins reset passwords on the Team screen.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
